msgstr "l'en-tête Strict-Transport-Security (HSTS) est absent"

msgid "TEXT_REVIEW_HEADERS_HSTS_SHORT"
msgstr "le max-age de HSTS est inférieur à 6 mois"

msgid "TEXT_REVIEW_HEADERS_XCTO_MISSING"
msgstr "l'en-tête X-Content-Type-Options est absent ou invalide"

msgid "TEXT_REVIEW_HEADERS_XFO_MISSING"
msgstr "il n'y a aucune protection contre l'intégration du site web dans d'autres sites web (X-Frame-Options ou frame-ancestors)"

msgid "TEXT_REVIEW_HEADERS_HSTS_NO_SUBDOMAINS"
msgstr "HSTS ne couvre pas les sous-domaines (includeSubDomains)"

msgid "TEXT_REVIEW_HEADERS_HSTS_NO_PRELOAD"
msgstr "HSTS n'est pas prêt pour le préchargement (preload)"

msgid "TEXT_REVIEW_SRI_VERY_GOOD"
msgstr "- Tous les scripts et feuilles de style utilisent Subresource Integrity (SRI)"

