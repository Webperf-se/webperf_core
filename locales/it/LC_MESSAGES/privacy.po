msgid "TEXT_RUNNING_TEST"
msgstr "## Test: 31 - Privacy (Webbkoll)\n"

msgid "TEXT_SERVICE_UNAVAILABLE"
msgstr "Impossibile raggiungere il servizio webbkoll-backend su {0}\n"

msgid "TEXT_REVIEW_VERY_GOOD"
msgstr "- Il sito web è ottimo in fatto di privacy!\n"

msgid "TEXT_REVIEW_IS_GOOD"
msgstr "- Il sito potrebbe fare meglio, ma è abbastanza buono.\n"

msgid "TEXT_REVIEW_IS_OK"
msgstr "- Impostazioni di privacy nella media, ma dovrebbero migliorare.\n"

msgid "TEXT_REVIEW_IS_BAD"
msgstr "- Piuttosto scarso nella privacy degli utenti.\n"

msgid "TEXT_REVIEW_IS_VERY_BAD"
msgstr "- Privacy pessima!\n"

msgid "TEXT_REVIEW_HTTPS_VERY_GOOD"
msgstr "- HTTPS è in uso e non vengono effettuate richieste non sicure"

msgid "TEXT_REVIEW_HTTPS_NO_HTTPS"
msgstr "il sito web non usa HTTPS"

msgid "TEXT_REVIEW_HTTPS_MIXED_CONTENT"
msgstr "{0} risorsa/e caricata/e tramite HTTP non sicuro (contenuto misto)"

msgid "TEXT_REVIEW_HTTPS_OLD_TLS"
msgstr "è in uso una versione TLS obsoleta ({0})"

msgid "TEXT_REVIEW_REFERRER_POLICY_VERY_GOOD"
msgstr "- La referrer policy protegge i visitatori ({0})"

msgid "TEXT_REVIEW_REFERRER_POLICY_MISSING"
msgstr "nessuna referrer policy impostata, i browser potrebbero rivelare gli indirizzi visitati ad altri siti web"

msgid "TEXT_REVIEW_REFERRER_POLICY_LEAKY"
msgstr "la referrer policy ({0}) potrebbe rivelare gli indirizzi visitati ad altri siti web"

msgid "TEXT_REVIEW_COOKIES_VERY_GOOD"
msgstr "- Nessun cookie problematico in uso"

msgid "TEXT_REVIEW_COOKIES_THIRD_PARTY"
msgstr "{0} cookie di terze parti, i visitatori potrebbero essere tracciati tra siti web diversi"

msgid "TEXT_REVIEW_COOKIES_LONG_LIVED"
msgstr "{0} cookie con durata superiore a un anno"

msgid "TEXT_REVIEW_COOKIES_NOT_SECURE"
msgstr "{0} cookie senza l'attributo Secure"

msgid "TEXT_REVIEW_THIRD_PARTY_VERY_GOOD"
msgstr "- Nessuna richiesta a terze parti"

msgid "TEXT_REVIEW_THIRD_PARTY_REQUESTS"
msgstr "vengono effettuate richieste a {0} dominio/i di terze parti"

msgid "TEXT_REVIEW_THIRD_PARTY_TRACKERS"
msgstr "vengono contattati {0} dominio/i di tracciamento noti"

msgid "TEXT_REVIEW_HEADERS_VERY_GOOD"
msgstr "- Gli header HTTP relativi a privacy e sicurezza sono presenti"

msgid "TEXT_REVIEW_HEADERS_HSTS_MISSING"
msgstr "manca l'header Strict-Transport-Security (HSTS)"

msgid "TEXT_REVIEW_HEADERS_HSTS_SHORT"
msgstr "il max-age di HSTS è inferiore a 6 mesi"

msgid "TEXT_REVIEW_HEADERS_XCTO_MISSING"
msgstr "l'header X-Content-Type-Options è mancante o non valido"

msgid "TEXT_REVIEW_HEADERS_XFO_MISSING"
msgstr "non c'è protezione contro l'incorporamento del sito web in altri siti web (X-Frame-Options o frame-ancestors)"

msgid "TEXT_REVIEW_HEADERS_HSTS_NO_SUBDOMAINS"
msgstr "HSTS non copre i sottodomini (includeSubDomains)"

msgid "TEXT_REVIEW_HEADERS_HSTS_NO_PRELOAD"
msgstr "HSTS non è pronto per il preload (preload)"

msgid "TEXT_REVIEW_SRI_VERY_GOOD"
msgstr "- Tutti gli script e i fogli di stile usano la Subresource Integrity (SRI)"

msgid "TEXT_REVIEW_SRI_MISSING"
msgstr "{0} script o fogli di stile caricati senza Subresource Integrity (SRI)"

msgid "TEXT_REVIEW_COOKIES_NOT_HTTP_ONLY"
msgstr "{0} cookie senza l'attributo HttpOnly"

msgid "TEXT_REVIEW_COOKIES_WEAK_SAME_SITE"
msgstr "{0} cookie senza un attributo SameSite forte (Lax o Strict)"
